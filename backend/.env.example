# Auto Reel Generator — Environment Variables
# Copy this file to .env and edit as needed.

# Directories (defaults are fine for local dev)
# UPLOAD_DIR=./uploads
# TEMP_DIR=./temp
# OUTPUT_DIR=./output
# CACHE_DIR=./cache

# Video
MAX_UPLOAD_SIZE_MB=500
DEFAULT_REEL_DURATION=30

# AI Models
CLIP_MODEL=ViT-B/32
WHISPER_MODEL=base
SCENE_THRESHOLD=30.0

# Scoring weights (must sum to 1.0)
WEIGHT_MOTION=0.25
WEIGHT_SHARPNESS=0.20
WEIGHT_CLIP=0.30
WEIGHT_AUDIO=0.15
WEIGHT_FACE=0.10

# Processing
FRAME_SAMPLE_FPS=2
MAX_WORKERS=4
